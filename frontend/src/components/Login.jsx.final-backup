import { useState } from "react";
import api from "../services/api";
import logo from "../assets/novapay-logo.svg";

function Login({ onLogin }) {
  const [username, setUsername] = useState("");
  const [password, setPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [loading, setLoading] = useState(false);

  const [forgotOpen, setForgotOpen] = useState(false);
  const [forgotStep, setForgotStep] = useState(1);
  const [forgotUsername, setForgotUsername] = useState("");
  const [forgotOtp, setForgotOtp] = useState("");
  const [newPassword, setNewPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");
  const [forgotLoading, setForgotLoading] = useState(false);

  const handleLogin = async () => {
    if (!username.trim() || !password) {
      alert("Please enter username and password");
      return;
    }

    try {
      setLoading(true);

      const res = await api.post("/auth/login", {
        username,
        password,
      });

      localStorage.setItem("token", res.data.token);
      localStorage.setItem("user", JSON.stringify(res.data.user));

      alert("✅ Login Successful");

      if (onLogin) {
        onLogin(res.data.user);
      }
    } catch (err) {
      alert(
        err.response?.data?.message || "Login Failed"
      );
    } finally {
      setLoading(false);
    }
  };

  const sendForgotOTP = async () => {
    if (!forgotUsername.trim()) {
      alert("Please enter your username");
      return;
    }

    try {
      setForgotLoading(true);

      await api.post("/auth/forgot-password", {
        username: forgotUsername.trim(),
      });

      alert("✅ OTP sent to your registered email");
      setForgotStep(2);
    } catch (err) {
      alert(
        err.response?.data?.message ||
        "Unable to send OTP"
      );
    } finally {
      setForgotLoading(false);
    }
  };

  const verifyForgotOTP = async () => {
    if (!forgotOtp.trim()) {
      alert("Please enter OTP");
      return;
    }

    try {
      setForgotLoading(true);

      await api.post("/auth/verify-otp", {
        username: forgotUsername.trim(),
        otp: forgotOtp.trim(),
      });

      alert("✅ OTP verified");
      setForgotStep(3);
    } catch (err) {
      alert(
        err.response?.data?.message ||
        "Invalid or expired OTP"
      );
    } finally {
      setForgotLoading(false);
    }
  };

  const resetForgotPassword = async () => {
    if (!newPassword || !confirmPassword) {
      alert("Please enter both passwords");
      return;
    }

    if (newPassword !== confirmPassword) {
      alert("Passwords do not match");
      return;
    }

    if (newPassword.length < 6) {
      alert("Password must be at least 6 characters");
      return;
    }

    try {
      setForgotLoading(true);

      await api.put("/auth/reset-password", {
        username: forgotUsername.trim(),
        newPassword,
      });

      alert("✅ Password reset successfully. Please login.");

      setForgotOpen(false);
      setForgotStep(1);
      setForgotUsername("");
      setForgotOtp("");
      setNewPassword("");
      setConfirmPassword("");
    } catch (err) {
      alert(
        err.response?.data?.message ||
        "Unable to reset password"
      );
    } finally {
      setForgotLoading(false);
    }
  };

  return (
    <div
      style={{
        minHeight: "100vh",
        display: "flex",
        background:
          "linear-gradient(135deg,#fff7f8 0%,#f8fafc 48%,#eef2f7 100%)",
        fontFamily:
          "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      }}
    >
      {/* LEFT BRAND PANEL */}
      <div
        style={{
          flex: 1,
          display: "flex",
          flexDirection: "column",
          justifyContent: "center",
          padding: "70px",
          background:
            "linear-gradient(145deg,#8f1530 0%,#b51f42 55%,#731128 100%)",
          color: "#fff",
          position: "relative",
          overflow: "hidden",
        }}
      >
        <div
          style={{
            position: "absolute",
            width: "420px",
            height: "420px",
            borderRadius: "50%",
            border: "1px solid rgba(255,255,255,.12)",
            right: "-180px",
            top: "-130px",
          }}
        />

        <div
          style={{
            position: "absolute",
            width: "300px",
            height: "300px",
            borderRadius: "50%",
            border: "1px solid rgba(255,255,255,.10)",
            right: "-100px",
            bottom: "-120px",
          }}
        />

        <div style={{ position: "relative", zIndex: 2 }}>
          <div
            style={{
              fontSize: "42px",
              fontWeight: "900",
              letterSpacing: "-2px",
              marginBottom: "14px",
            }}
          >
            NOVA<span style={{ color: "#ffd9e0" }}>PAY</span>
          </div>

          <div
            style={{
              fontSize: "16px",
              fontWeight: "600",
              letterSpacing: "1px",
              opacity: ".85",
              marginBottom: "55px",
            }}
          >
            DIGITAL BANKING
          </div>

          <h1
            style={{
              fontSize: "44px",
              lineHeight: "1.12",
              margin: 0,
              maxWidth: "560px",
              letterSpacing: "-1.5px",
            }}
          >
            Banking made
            <br />
            simple & secure.
          </h1>

          <p
            style={{
              marginTop: "22px",
              maxWidth: "500px",
              fontSize: "17px",
              lineHeight: "1.7",
              color: "rgba(255,255,255,.78)",
            }}
          >
            Manage your money, transfers, payments and
            transactions from one secure digital banking
            platform.
          </p>

          <div
            style={{
              display: "flex",
              gap: "14px",
              marginTop: "38px",
              flexWrap: "wrap",
            }}
          >
            <div
              style={{
                padding: "12px 17px",
                borderRadius: "12px",
                background: "rgba(255,255,255,.10)",
                border: "1px solid rgba(255,255,255,.14)",
                fontSize: "13px",
                fontWeight: "700",
              }}
            >
              🔒 Secure Banking
            </div>

            <div
              style={{
                padding: "12px 17px",
                borderRadius: "12px",
                background: "rgba(255,255,255,.10)",
                border: "1px solid rgba(255,255,255,.14)",
                fontSize: "13px",
                fontWeight: "700",
              }}
            >
              ⚡ Fast Transactions
            </div>

              <div
                style={{
                  padding: "12px 17px",
                  borderRadius: "12px",
                  background: "rgba(255,255,255,.10)",
                  border: "1px solid rgba(255,255,255,.14)",
                  fontSize: "13px",
                  fontWeight: "700",
                }}
              >
                🛡️ 24/7 Protection
              </div>
          </div>
        </div>
      </div>

      {/* RIGHT LOGIN PANEL */}
      <div
        style={{
          width: "500px",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          padding: "40px",
          boxSizing: "border-box",
        }}
      >
        <div
          style={{
            width: "100%",
            maxWidth: "400px",
            background: "#ffffff",
            border: "1px solid #e5e7eb",
            borderRadius: "24px",
            padding: "38px",
            boxSizing: "border-box",
            boxShadow:
              "0 25px 60px rgba(15,23,42,.10)",
          }}
        >
          {/* HEADER */}
          <div style={{ marginBottom: "32px" }}>
            <img
              src={logo}
              alt="NovaPay"
              style={{
                width: "210px",
                height: "auto",
                display: "block",
                marginBottom: "28px",
                objectFit: "contain",
              }}
            />

            <h2
              style={{
                margin: 0,
                color: "#172033",
                fontSize: "29px",
                fontWeight: "850",
                letterSpacing: "-.7px",
              }}
            >
              Welcome back
            </h2>

            <p
              style={{
                margin: "8px 0 0",
                color: "#64748b",
                fontSize: "14px",
                lineHeight: "1.5",
              }}
            >
              Sign in to access your NovaPay account.
            </p>
          </div>

          {/* USERNAME */}
          <div style={{ marginBottom: "19px" }}>
            <label
              style={{
                display: "block",
                marginBottom: "8px",
                color: "#334155",
                fontSize: "13px",
                fontWeight: "800",
              }}
            >
              Username
            </label>

            <div style={{ position: "relative" }}>
              <span
                style={{
                  position: "absolute",
                  left: "14px",
                  top: "50%",
                  transform: "translateY(-50%)",
                  fontSize: "17px",
                }}
              >
                👤
              </span>

              <input
                type="text"
                placeholder="Enter your username"
                value={username}
                onChange={(e) => setUsername(e.target.value)}
                onKeyDown={(e) => {
                  if (e.key === "Enter") {
                    handleLogin();
                  }
                }}
                style={{
                  width: "100%",
                  height: "50px",
                  padding: "0 14px 0 43px",
                  boxSizing: "border-box",
                  border: "1px solid #d8dee8",
                  borderRadius: "12px",
                  outline: "none",
                  fontSize: "14px",
                  color: "#172033",
                  background: "#fff",
                }}
              />
            </div>
          </div>

          {/* PASSWORD */}
          <div style={{ marginBottom: "14px" }}>
            <label
              style={{
                display: "block",
                marginBottom: "8px",
                color: "#334155",
                fontSize: "13px",
                fontWeight: "800",
              }}
            >
              Password
            </label>

            <div style={{ position: "relative" }}>
              <span
                style={{
                  position: "absolute",
                  left: "14px",
                  top: "50%",
                  transform: "translateY(-50%)",
                  fontSize: "17px",
                }}
              >
                🔑
              </span>

              <input
                type={showPassword ? "text" : "password"}
                placeholder="Enter your password"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                onKeyDown={(e) => {
                  if (e.key === "Enter") {
                    handleLogin();
                  }
                }}
                style={{
                  width: "100%",
                  height: "50px",
                  padding: "0 48px 0 43px",
                  boxSizing: "border-box",
                  border: "1px solid #d8dee8",
                  borderRadius: "12px",
                  outline: "none",
                  fontSize: "14px",
                  color: "#172033",
                  background: "#fff",
                }}
              />

              <button
                type="button"
                onClick={() =>
                  setShowPassword(!showPassword)
                }
                style={{
                  position: "absolute",
                  right: "8px",
                  top: "7px",
                  width: "36px",
                  height: "36px",
                  border: "none",
                  background: "transparent",
                  cursor: "pointer",
                  fontSize: "16px",
                }}
              >
                {showPassword ? "🙈" : "👁️"}
              </button>
            </div>
          </div>

          {/* REMEMBER */}
          <div
            style={{
              display: "flex",
              alignItems: "center",
              justifyContent: "space-between",
              marginBottom: "25px",
            }}
          >
            <label
              style={{
                display: "flex",
                alignItems: "center",
                gap: "8px",
                fontSize: "13px",
                color: "#64748b",
                cursor: "pointer",
              }}
            >
              <input type="checkbox" />
              Remember me
            </label>

            <button
                type="button"
                onClick={() => {
                  setForgotOpen(true);
                  setForgotStep(1);
                  setForgotUsername("");
                  setForgotOtp("");
                  setNewPassword("");
                  setConfirmPassword("");
                }}
                style={{
                  border: "none",
                  background: "transparent",
                  padding: 0,
                  fontSize: "13px",
                  color: "#9d1730",
                  fontWeight: "800",
                  cursor: "pointer",
                }}
              >
                Forgot password?
              </button>
          </div>

          {/* LOGIN BUTTON */}
          <button
            onClick={handleLogin}
            disabled={loading}
            style={{
              width: "100%",
              height: "52px",
              border: "none",
              borderRadius: "12px",
              background: loading
                ? "#b86a7b"
                : "linear-gradient(135deg,#9d1730,#b91c3c)",
              color: "#ffffff",
              fontSize: "15px",
              fontWeight: "800",
              cursor: loading ? "not-allowed" : "pointer",
              boxShadow:
                "0 10px 22px rgba(157,23,48,.22)",
            }}
          >
            {loading ? "Signing in..." : "Sign In  →"}
          </button>

          {/* SECURITY NOTE */}
          <div
            style={{
              marginTop: "24px",
              paddingTop: "20px",
              borderTop: "1px solid #eef0f3",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              gap: "7px",
              color: "#94a3b8",
              fontSize: "11px",
              fontWeight: "600",
            }}
          >
            🔒 Your connection is secure
          </div>
        </div>
      </div>
    </div>
  );
}

      {forgotOpen && (
        <div
          style={{
            position: "fixed",
            inset: 0,
            background: "rgba(15,23,42,.65)",
            backdropFilter: "blur(6px)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            zIndex: 9999,
            padding: "20px",
          }}
        >
          <div
            style={{
              width: "100%",
              maxWidth: "430px",
              background: "#ffffff",
              borderRadius: "24px",
              padding: "34px",
              boxSizing: "border-box",
              boxShadow: "0 30px 80px rgba(0,0,0,.25)",
            }}
          >
            <div
              style={{
                display: "flex",
                justifyContent: "space-between",
                alignItems: "center",
                marginBottom: "24px",
              }}
            >
              <div>
                <h2
                  style={{
                    margin: 0,
                    color: "#172033",
                    fontSize: "25px",
                    fontWeight: "850",
                  }}
                >
                  Reset Password
                </h2>

                <p
                  style={{
                    margin: "7px 0 0",
                    color: "#64748b",
                    fontSize: "13px",
                  }}
                >
                  Secure your NovaPay account
                </p>
              </div>

              <button
                type="button"
                onClick={() => setForgotOpen(false)}
                style={{
                  border: "none",
                  background: "#f1f5f9",
                  width: "36px",
                  height: "36px",
                  borderRadius: "10px",
                  cursor: "pointer",
                  fontSize: "18px",
                }}
              >
                ✕
              </button>
            </div>

            {forgotStep === 1 && (
              <>
                <div
                  style={{
                    background: "#f8e8ec",
                    borderRadius: "14px",
                    padding: "14px",
                    marginBottom: "22px",
                    color: "#8f1530",
                    fontSize: "13px",
                    lineHeight: "1.5",
                  }}
                >
                  📧 Enter your username. We will send a one-time OTP to
                  your registered email address.
                </div>

                <label
                  style={{
                    display: "block",
                    marginBottom: "8px",
                    fontSize: "13px",
                    fontWeight: "800",
                    color: "#334155",
                  }}
                >
                  Username
                </label>

                <input
                  type="text"
                  placeholder="Enter your username"
                  value={forgotUsername}
                  onChange={(e) => setForgotUsername(e.target.value)}
                  style={{
                    width: "100%",
                    height: "50px",
                    padding: "0 14px",
                    border: "1px solid #d8dee8",
                    borderRadius: "12px",
                    outline: "none",
                    fontSize: "14px",
                    boxSizing: "border-box",
                  }}
                />

                <button
                  type="button"
                  onClick={sendForgotOTP}
                  disabled={forgotLoading}
                  style={{
                    width: "100%",
                    height: "52px",
                    marginTop: "18px",
                    border: "none",
                    borderRadius: "12px",
                    background: "#9d1730",
                    color: "#fff",
                    fontSize: "15px",
                    fontWeight: "800",
                    cursor: forgotLoading ? "not-allowed" : "pointer",
                  }}
                >
                  {forgotLoading ? "Sending OTP..." : "Send OTP →"}
                </button>
              </>
            )}

            {forgotStep === 2 && (
              <>
                <div
                  style={{
                    background: "#f0fdf4",
                    borderRadius: "14px",
                    padding: "14px",
                    marginBottom: "22px",
                    color: "#166534",
                    fontSize: "13px",
                    lineHeight: "1.5",
                  }}
                >
                  ✅ OTP sent to your registered email. Enter the OTP to
                  continue.
                </div>

                <label
                  style={{
                    display: "block",
                    marginBottom: "8px",
                    fontSize: "13px",
                    fontWeight: "800",
                    color: "#334155",
                  }}
                >
                  One-Time Password
                </label>

                <input
                  type="text"
                  inputMode="numeric"
                  maxLength="6"
                  placeholder="Enter 6-digit OTP"
                  value={forgotOtp}
                  onChange={(e) =>
                    setForgotOtp(e.target.value.replace(/\D/g, ""))
                  }
                  style={{
                    width: "100%",
                    height: "52px",
                    padding: "0 14px",
                    border: "1px solid #d8dee8",
                    borderRadius: "12px",
                    outline: "none",
                    fontSize: "20px",
                    letterSpacing: "5px",
                    textAlign: "center",
                    boxSizing: "border-box",
                  }}
                />

                <button
                  type="button"
                  onClick={verifyForgotOTP}
                  disabled={forgotLoading}
                  style={{
                    width: "100%",
                    height: "52px",
                    marginTop: "18px",
                    border: "none",
                    borderRadius: "12px",
                    background: "#9d1730",
                    color: "#fff",
                    fontSize: "15px",
                    fontWeight: "800",
                    cursor: forgotLoading ? "not-allowed" : "pointer",
                  }}
                >
                  {forgotLoading ? "Verifying..." : "Verify OTP →"}
                </button>
              </>
            )}

            {forgotStep === 3 && (
              <>
                <div
                  style={{
                    background: "#f0fdf4",
                    borderRadius: "14px",
                    padding: "14px",
                    marginBottom: "22px",
                    color: "#166534",
                    fontSize: "13px",
                  }}
                >
                  🔐 OTP verified. Create your new password.
                </div>

                <label
                  style={{
                    display: "block",
                    marginBottom: "8px",
                    fontSize: "13px",
                    fontWeight: "800",
                    color: "#334155",
                  }}
                >
                  New Password
                </label>

                <input
                  type="password"
                  placeholder="Enter new password"
                  value={newPassword}
                  onChange={(e) => setNewPassword(e.target.value)}
                  style={{
                    width: "100%",
                    height: "50px",
                    padding: "0 14px",
                    border: "1px solid #d8dee8",
                    borderRadius: "12px",
                    outline: "none",
                    fontSize: "14px",
                    boxSizing: "border-box",
                    marginBottom: "14px",
                  }}
                />

                <label
                  style={{
                    display: "block",
                    marginBottom: "8px",
                    fontSize: "13px",
                    fontWeight: "800",
                    color: "#334155",
                  }}
                >
                  Confirm Password
                </label>

                <input
                  type="password"
                  placeholder="Confirm new password"
                  value={confirmPassword}
                  onChange={(e) => setConfirmPassword(e.target.value)}
                  style={{
                    width: "100%",
                    height: "50px",
                    padding: "0 14px",
                    border: "1px solid #d8dee8",
                    borderRadius: "12px",
                    outline: "none",
                    fontSize: "14px",
                    boxSizing: "border-box",
                  }}
                />

                <button
                  type="button"
                  onClick={resetForgotPassword}
                  disabled={forgotLoading}
                  style={{
                    width: "100%",
                    height: "52px",
                    marginTop: "18px",
                    border: "none",
                    borderRadius: "12px",
                    background: "#9d1730",
                    color: "#fff",
                    fontSize: "15px",
                    fontWeight: "800",
                    cursor: forgotLoading ? "not-allowed" : "pointer",
                  }}
                >
                  {forgotLoading ? "Updating..." : "Update Password →"}
                </button>
              </>
            )}

            <div
              style={{
                marginTop: "20px",
                textAlign: "center",
                fontSize: "11px",
                color: "#94a3b8",
              }}
            >
              🔒 NovaPay secure password recovery
            </div>
          </div>
        </div>
      )}

export default Login;
